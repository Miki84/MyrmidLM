[Unit]
Description=MyrmidLM GPU worker (lends this PC's GPU to phone masters)
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# Adjust the path if you installed elsewhere (build.sh --install DIR).
ExecStart=/opt/myrmid/current/bin/myrmid worker --cache --ram
# Listen on one interface only, e.g. the LAN or VPN address:
#ExecStart=/opt/myrmid/current/bin/myrmid worker --cache --host 192.168.1.10
DynamicUser=yes
# Requests to the root helpers (sleep, role switch, update): /run/myrmid
RuntimeDirectory=myrmid
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
CacheDirectory=myrmid
Environment=XDG_CACHE_HOME=/var/cache/myrmid
StateDirectory=myrmid
Environment=XDG_CONFIG_HOME=/var/lib/myrmid
# GPU access (NVIDIA /dev/nvidia*, AMD/Intel /dev/dri, /dev/kfd).
SupplementaryGroups=video render
Restart=on-failure
RestartSec=5
# Exit 2 = the model doesn't fit: restarting won't help
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
