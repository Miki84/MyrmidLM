[Unit]
Description=PrivateLM model server (OpenAI-compatible API, optional phone workers)
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# Set the model path. --workers auto uses workers where they make it faster or
# are needed for memory; "all" every worker with room; "off" none.
ExecStart=/opt/privatelm-node/bin/privatelm-node serve -m /srv/models/model.gguf --workers auto
DynamicUser=yes
CacheDirectory=privatelm-node
Environment=XDG_CACHE_HOME=/var/cache/privatelm-node
StateDirectory=privatelm-node
Environment=XDG_CONFIG_HOME=/var/lib/privatelm-node
SupplementaryGroups=video render
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
