[Unit]
Description=PrivateLM host (loads a whole model for the master's router)
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
# The cluster key is the master's API key (on the master: privatelm-node key).
# Put it in /etc/privatelm-node/cluster_key (root only, chmod 600).
LoadCredential=cluster_key:/etc/privatelm-node/cluster_key
# For sleep on the master's request (with privatelm-suspend.path):
RuntimeDirectory=privatelm-node
RuntimeDirectoryMode=0755
ExecStart=/opt/privatelm-node/bin/privatelm-node host --models-dir /var/lib/privatelm-node/models
DynamicUser=yes
CacheDirectory=privatelm-node
Environment=XDG_CACHE_HOME=/var/cache/privatelm-node
StateDirectory=privatelm-node
Environment=XDG_CONFIG_HOME=/var/lib/privatelm-node
# GPU access (NVIDIA /dev/nvidia*, AMD/Intel /dev/dri, /dev/kfd).
SupplementaryGroups=video render
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
